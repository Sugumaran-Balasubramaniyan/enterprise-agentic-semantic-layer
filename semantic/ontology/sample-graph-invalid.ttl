@prefix insurance: <https://globalsure.example/insurance/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

insurance:SampleGraphInvalid a owl:Ontology ; owl:versionInfo "1.0.0" .
insurance:policy-FR-BAD a insurance:Policy ;
    insurance:policyId "FR_POL_BAD" ;
    insurance:hasProduct insurance:MotorInsurance ;
    insurance:policyStatus "ACTIVE" .
insurance:MotorInsurance a insurance:MotorInsurance, insurance:InsuranceProduct .
insurance:claim-FR-BAD a insurance:Claim ;
    insurance:claimId "FR_CLM_BAD" ;
    insurance:claimStatus "OPEN" ;
    insurance:relatesToPolicy insurance:policy-FR-BAD ;
    insurance:incurredLoss "-10.00"^^xsd:decimal .

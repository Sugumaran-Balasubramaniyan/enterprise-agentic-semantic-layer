@prefix sap: <https://sap.example/erp/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sap:SampleGraphInvalid a owl:Ontology ; owl:versionInfo "1.0.0" .
sap:order-FR-BAD a sap:SalesOrder ;
    sap:salesOrderId "FR_SO_BAD" ;
    sap:hasProduct sap:ProductAutomotive ;
    sap:orderStatus "RELEASED" .
sap:ProductAutomotive a sap:ProductAutomotive, sap:Product .
sap:doc-FR-BAD a sap:FinancialPosting ;
    sap:journalEntryId "FR_DOC_BAD" ;
    sap:postingStatus "POSTED" ;
    sap:referencesSalesOrder sap:order-FR-BAD ;
    sap:amountInCompanyCurrency "-10.00"^^xsd:decimal .

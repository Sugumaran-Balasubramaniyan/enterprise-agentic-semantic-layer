@prefix ciferp: <https://example.org/cifre-kg/erp#> .
@prefix cifmeta: <https://example.org/cifre-kg/meta#> .
@prefix cifmetaid: <https://example.org/cifre-kg/id/meta/> .
@prefix cifskos: <https://example.org/cifre-kg/vocabulary#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ciferp: a owl:Ontology ;
    rdfs:label "Synthetic ERP semantic layer ontology"@en ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <https://example.org/cifre-kg/erp#1.0.0> .

ciferp:BusinessPartner a owl:Class .
ciferp:SalesOrder a owl:Class .
ciferp:FinancialPosting a owl:Class .
ciferp:Product a owl:Class .
ciferp:ProductAutomotive a owl:Class ; rdfs:subClassOf ciferp:Product .
ciferp:ProductCommercial a owl:Class ; rdfs:subClassOf ciferp:Product .
ciferp:Risk a owl:Class .
ciferp:Coverage a owl:Class .
ciferp:BillingDocument a owl:Class .
ciferp:PostingStatus a owl:Class .
ciferp:CompanyCode a owl:Class .
ciferp:CountryCodedEntity a owl:Class .
ciferp:BusinessPartner rdfs:subClassOf ciferp:CountryCodedEntity .
ciferp:SalesOrder rdfs:subClassOf ciferp:CountryCodedEntity .
ciferp:ActiveSalesOrder a owl:Class ; rdfs:subClassOf ciferp:SalesOrder .
ciferp:QualifyingPosting a owl:Class ; rdfs:subClassOf ciferp:FinancialPosting .
ciferp:FinancialLoss a owl:Class .

ciferp:hasSalesOrder a owl:ObjectProperty ;
    rdfs:domain ciferp:BusinessPartner ; rdfs:range ciferp:SalesOrder .
ciferp:hasFinancialPosting a owl:ObjectProperty ;
    rdfs:domain ciferp:BusinessPartner ; rdfs:range ciferp:FinancialPosting .
ciferp:referencesSalesOrder a owl:ObjectProperty ;
    rdfs:domain ciferp:FinancialPosting ; rdfs:range ciferp:SalesOrder .
ciferp:postingOrder a owl:ObjectProperty ;
    rdfs:subPropertyOf ciferp:referencesSalesOrder ;
    rdfs:domain ciferp:FinancialPosting ; rdfs:range ciferp:SalesOrder .
ciferp:hasProduct a owl:ObjectProperty ;
    rdfs:domain ciferp:SalesOrder ; rdfs:range ciferp:Product .
ciferp:orderProduct a owl:ObjectProperty ;
    rdfs:subPropertyOf ciferp:hasProduct ;
    rdfs:domain ciferp:SalesOrder ; rdfs:range ciferp:Product .
ciferp:coversRisk a owl:ObjectProperty ;
    rdfs:domain ciferp:SalesOrder ; rdfs:range ciferp:Risk .
ciferp:hasCoverage a owl:ObjectProperty ;
    rdfs:domain ciferp:SalesOrder ; rdfs:range ciferp:Coverage .
ciferp:referencesBusinessPartner a owl:ObjectProperty ;
    rdfs:domain ciferp:SalesOrder ; rdfs:range ciferp:BusinessPartner .
ciferp:generatesBilling a owl:ObjectProperty ;
    rdfs:domain ciferp:SalesOrder ; rdfs:range ciferp:BillingDocument .
ciferp:hasPostingStatus a owl:ObjectProperty ;
    rdfs:domain ciferp:FinancialPosting ; rdfs:range ciferp:PostingStatus .
ciferp:hasFinancialLoss a owl:ObjectProperty ;
    rdfs:domain ciferp:FinancialPosting ; rdfs:range ciferp:FinancialLoss .

ciferp:partnerId a owl:DatatypeProperty ;
    rdfs:domain ciferp:BusinessPartner ; rdfs:range xsd:string .
ciferp:salesOrderId a owl:DatatypeProperty ;
    rdfs:domain ciferp:SalesOrder ; rdfs:range xsd:string .
ciferp:journalEntryId a owl:DatatypeProperty ;
    rdfs:domain ciferp:FinancialPosting ; rdfs:range xsd:string .
ciferp:countryCode a owl:DatatypeProperty ;
    rdfs:domain ciferp:CountryCodedEntity ; rdfs:range xsd:string .
ciferp:orderStatus a owl:DatatypeProperty ;
    rdfs:domain ciferp:SalesOrder ; rdfs:range xsd:string .
ciferp:postingDate a owl:DatatypeProperty ;
    rdfs:domain ciferp:FinancialPosting ; rdfs:range xsd:date .
ciferp:postingStatus a owl:DatatypeProperty ;
    rdfs:domain ciferp:FinancialPosting ; rdfs:range xsd:string .
ciferp:amountInCompanyCurrency a owl:DatatypeProperty ;
    rdfs:domain ciferp:FinancialPosting ; rdfs:range xsd:decimal .
ciferp:statusValue a owl:DatatypeProperty ;
    rdfs:domain ciferp:PostingStatus ; rdfs:range xsd:string .
ciferp:amountValue a owl:DatatypeProperty ;
    rdfs:domain ciferp:FinancialLoss ; rdfs:range xsd:decimal .

cifmeta:CrosswalkEntry a owl:Class .
cifmeta:sourceResource a owl:ObjectProperty ;
    rdfs:domain cifmeta:CrosswalkEntry ; rdfs:range ciferp:Product .
cifmeta:targetConcept a owl:ObjectProperty ;
    rdfs:domain cifmeta:CrosswalkEntry ; rdfs:range skos:Concept .
cifmeta:crosswalkVersion a owl:DatatypeProperty ;
    rdfs:domain cifmeta:CrosswalkEntry ; rdfs:range xsd:string .

cifmetaid:crosswalk-entry-product-automotive a cifmeta:CrosswalkEntry ;
    cifmeta:sourceResource ciferp:ProductAutomotive ;
    cifmeta:targetConcept cifskos:ProductAutomotive ;
    cifmeta:crosswalkVersion "1.0"^^xsd:string .

@prefix sap: <https://sap.example/erp/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sap:SampleGraphValid a owl:Ontology ; owl:versionInfo "1.0.0" .
sap:partner-FR-001 a sap:BusinessPartner ;
    sap:partnerId "FR_001" ;
    sap:countryCode "FR" ;
    sap:hasSalesOrder sap:order-FR-001 ;
    sap:hasFinancialPosting sap:doc-FR-001 .
sap:order-FR-001 a sap:SalesOrder ;
    sap:salesOrderId "FR_SO_001" ;
    sap:countryCode "FR" ;
    sap:hasProduct sap:ProductAutomotive ;
    sap:orderStatus "RELEASED" ;
    sap:coversRisk sap:risk-FR-001 ;
    sap:hasCoverage sap:coverage-FR-001 ;
    sap:generatesBilling sap:billing-FR-001 .
sap:ProductAutomotive a sap:ProductAutomotive, sap:Product .
sap:risk-FR-001 a sap:Risk .
sap:coverage-FR-001 a sap:Coverage .
sap:billing-FR-001 a sap:BillingDocument .
sap:doc-FR-001 a sap:FinancialPosting ;
    sap:journalEntryId "FR_DOC_001" ;
    sap:postingDate "2026-06-01"^^xsd:date ;
    sap:postingStatus "POSTED" ;
    sap:referencesSalesOrder sap:order-FR-001 ;
    sap:amountInCompanyCurrency "25000.00"^^xsd:decimal ;
    sap:hasPostingStatus sap:status-posted ;
    sap:hasFinancialLoss sap:loss-FR-001 .
sap:status-posted a sap:PostingStatus ; sap:statusValue "POSTED" .
sap:loss-FR-001 a sap:FinancialLoss ; sap:amountValue "25000.00"^^xsd:decimal .

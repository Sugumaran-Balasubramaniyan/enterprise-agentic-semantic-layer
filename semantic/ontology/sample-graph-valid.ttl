@prefix ciferp: <https://example.org/cifre-kg/erp#> .
@prefix cifmeta: <https://example.org/cifre-kg/meta#> .
@prefix cifmetaid: <https://example.org/cifre-kg/id/meta/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cifmetaid:sample-graph-valid a owl:Ontology ; owl:versionInfo "1.0.0" .
cifmetaid:dataset-sample-valid a cifmeta:SyntheticDataset ;
    cifmeta:datasetId "cifre-synthetic-erp-valid" ;
    cifmeta:sourceKind "synthetic_fixture" ;
    cifmeta:official false .

<https://example.org/cifre-kg/data/erp/partner-FR-001> a ciferp:BusinessPartner ;
    ciferp:partnerId "FR_001"^^xsd:string ;
    ciferp:countryCode "FR"^^xsd:string ;
    ciferp:hasSalesOrder <https://example.org/cifre-kg/data/erp/order-FR-001> ;
    ciferp:hasFinancialPosting <https://example.org/cifre-kg/data/erp/doc-FR-001> .
<https://example.org/cifre-kg/data/erp/order-FR-001> a ciferp:SalesOrder ;
    ciferp:salesOrderId "FR_SO_001"^^xsd:string ;
    ciferp:countryCode "FR"^^xsd:string ;
    ciferp:hasProduct <https://example.org/cifre-kg/data/erp/product-automotive> ;
    ciferp:orderStatus "RELEASED"^^xsd:string ;
    ciferp:coversRisk <https://example.org/cifre-kg/data/erp/risk-FR-001> ;
    ciferp:hasCoverage <https://example.org/cifre-kg/data/erp/coverage-FR-001> ;
    ciferp:generatesBilling <https://example.org/cifre-kg/data/erp/billing-FR-001> .
<https://example.org/cifre-kg/data/erp/product-automotive> a ciferp:Product .
<https://example.org/cifre-kg/data/erp/risk-FR-001> a ciferp:Risk .
<https://example.org/cifre-kg/data/erp/coverage-FR-001> a ciferp:Coverage .
<https://example.org/cifre-kg/data/erp/billing-FR-001> a ciferp:BillingDocument .
<https://example.org/cifre-kg/data/erp/doc-FR-001> a ciferp:FinancialPosting ;
    ciferp:journalEntryId "FR_DOC_001"^^xsd:string ;
    ciferp:postingDate "2026-06-01"^^xsd:date ;
    ciferp:postingStatus "POSTED"^^xsd:string ;
    ciferp:referencesSalesOrder <https://example.org/cifre-kg/data/erp/order-FR-001> ;
    ciferp:amountInCompanyCurrency "25000.00"^^xsd:decimal ;
    ciferp:hasPostingStatus <https://example.org/cifre-kg/data/erp/status-posted> ;
    ciferp:hasFinancialLoss <https://example.org/cifre-kg/data/erp/loss-FR-001> .
<https://example.org/cifre-kg/data/erp/status-posted> a ciferp:PostingStatus ; ciferp:statusValue "POSTED"^^xsd:string .
<https://example.org/cifre-kg/data/erp/loss-FR-001> a ciferp:FinancialLoss ; ciferp:amountValue "25000.00"^^xsd:decimal .

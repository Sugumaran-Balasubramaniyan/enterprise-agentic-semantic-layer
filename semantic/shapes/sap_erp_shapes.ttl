@prefix ciferp: <https://example.org/cifre-kg/erp#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ciferp:ERPShapes a sh:NodeShape ; owl:versionInfo "1.0.0" .

ciferp:FinancialPostingShape a sh:NodeShape ;
    sh:targetClass ciferp:FinancialPosting ;
    sh:property [ sh:path ciferp:journalEntryId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ciferp:postingDate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path ciferp:postingStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "POSTED"^^xsd:string "CLEARED"^^xsd:string "REVERSED"^^xsd:string "DUPLICATE"^^xsd:string ) ] ;
    sh:property [ sh:path ciferp:referencesSalesOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ciferp:SalesOrder ] ;
    sh:property [ sh:path ciferp:amountInCompanyCurrency ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] .

ciferp:SalesOrderShape a sh:NodeShape ;
    sh:targetClass ciferp:SalesOrder ;
    sh:property [ sh:path ciferp:salesOrderId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ciferp:hasProduct ; sh:minCount 1 ; sh:class ciferp:Product ] ;
    sh:property [ sh:path ciferp:orderStatus ; sh:minCount 1 ; sh:in ( "RELEASED"^^xsd:string "CLOSED"^^xsd:string "CANCELLED"^^xsd:string ) ] .

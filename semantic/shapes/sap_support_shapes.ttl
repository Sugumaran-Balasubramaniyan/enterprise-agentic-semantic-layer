@prefix cifsup: <https://example.org/cifre-kg/support#> .
@prefix cifppms: <https://example.org/cifre-kg/ppms#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cifsup:SupportShapes a sh:NodeShape ; owl:versionInfo "1.0.0" .

cifsup:SAPNoteShape a sh:NodeShape ;
    sh:targetClass cifsup:SAPNote ;
    sh:property [
        sh:path cifsup:noteNumber ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Every synthetic support note has exactly one note number."@en
    ] ;
    sh:property [
        sh:path cifsup:title ; sh:datatype rdf:langString ; sh:languageIn ( "en" ) ; sh:minCount 1 ;
        sh:message "Every synthetic support note has an English title."@en
    ] ;
    sh:property [
        sh:path cifsup:priority ; sh:in ( "Very High"^^xsd:string "High"^^xsd:string "Medium"^^xsd:string "Low"^^xsd:string ) ; sh:minCount 1
    ] ;
    sh:property [
        sh:path cifsup:affectsComponent ; sh:class cifsup:ApplicationComponent ; sh:minCount 1
    ] ;
    sh:property [
        sh:path cifsup:validForComponentVersion ; sh:class cifppms:SoftwareComponentVersion ; sh:minCount 1
    ] ;
    sh:property [ sh:path cifsup:symptom ; sh:datatype rdf:langString ; sh:languageIn ( "en" ) ] ;
    sh:property [ sh:path cifsup:rootCause ; sh:datatype rdf:langString ; sh:languageIn ( "en" ) ] ;
    sh:property [ sh:path cifsup:resolution ; sh:datatype rdf:langString ; sh:languageIn ( "en" ) ] .

cifsup:SystemAlertShape a sh:NodeShape ;
    sh:targetClass cifsup:SystemAlert ;
    sh:property [ sh:path cifsup:alertCode ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cifsup:severity ; sh:in ( "CRITICAL"^^xsd:string "ERROR"^^xsd:string "WARNING"^^xsd:string "INFO"^^xsd:string ) ; sh:minCount 1 ] ;
    sh:property [ sh:path cifsup:affectsComponent ; sh:class cifsup:ApplicationComponent ; sh:minCount 1 ] .

cifsup:ApplicationComponentShape a sh:NodeShape ;
    sh:targetClass cifsup:ApplicationComponent ;
    sh:property [ sh:path cifsup:componentCode ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cifsup:componentDescription ; sh:datatype rdf:langString ; sh:languageIn ( "en" ) ] .

cifsup:SimCatCategoryShape a sh:NodeShape ;
    sh:targetClass cifsup:SimCatCategory ;
    sh:property [ sh:path cifsup:categoryName ; sh:datatype rdf:langString ; sh:languageIn ( "en" ) ; sh:minCount 1 ] .

cifsup:HelpDocumentationShape a sh:NodeShape ;
    sh:targetClass cifsup:HelpDocumentation ;
    sh:property [ sh:path cifsup:docUri ; sh:datatype xsd:anyURI ; sh:minCount 1 ; sh:maxCount 1 ] .

cifppms:ProductVersionShape a sh:NodeShape ;
    sh:targetClass cifppms:ProductVersion ;
    sh:property [ sh:path cifppms:versionCode ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cifppms:includesComponent ; sh:class cifppms:SoftwareComponentVersion ; sh:minCount 1 ] .

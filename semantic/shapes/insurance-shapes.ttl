@prefix insurance: <https://globalsure.example/insurance/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

insurance:InsuranceShapes a sh:NodeShape ;
    owl:versionInfo "1.0.0" .

insurance:ClaimShape a sh:NodeShape ;
    sh:targetClass insurance:Claim ;
    sh:property [ sh:path insurance:claimId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path insurance:claimDate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path insurance:claimStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "OPEN" "PENDING" "SETTLED" "CANCELLED" "DUPLICATE" ) ] ;
    sh:property [ sh:path insurance:relatesToPolicy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class insurance:Policy ] ;
    sh:property [ sh:path insurance:incurredLoss ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] .

insurance:PolicyShape a sh:NodeShape ;
    sh:targetClass insurance:Policy ;
    sh:property [ sh:path insurance:policyId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path insurance:hasProduct ; sh:minCount 1 ; sh:maxCount 1 ; sh:class insurance:InsuranceProduct ] ;
    sh:property [ sh:path insurance:policyStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "ACTIVE" "LAPSED" "CANCELLED" ) ] .
